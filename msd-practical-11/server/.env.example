# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/mern_blog_db?retryWrites=true&w=majority

# JWT Secret Key for signing authentication tokens
JWT_SECRET=replace_this_with_a_strong_random_secret_key_12345
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin for CORS
CLIENT_URL=http://localhost:5173
