# ============================================================================
# Practical 13: MERN Document Management System - Environment Example
# ============================================================================
# Copy `server/.env.example` to `server/.env` and `client/.env.example` to `client/.env`

# --- Backend (server/.env) ---
PORT=5050
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/practical13_dms?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_strong_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE_MB=10

# --- Frontend (client/.env) ---
VITE_API_URL=http://localhost:5050/api
